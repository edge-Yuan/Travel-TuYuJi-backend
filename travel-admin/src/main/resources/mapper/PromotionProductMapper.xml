<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wanderlust.travel.traveladmin.mapper.PromotionProductMapper">

    <!-- 批量插入活动产品关联 -->
    <insert id="batchInsert">
        INSERT INTO promotion_product (promotion_id, product_id, create_time)
        VALUES
        <foreach collection="productIds" item="productId" separator=",">
            (#{promotionId}, #{productId}, NOW())
        </foreach>
    </insert>

    <!-- 根据活动ID删除关联 -->
    <delete id="deleteByPromotionId">
        DELETE FROM promotion_product WHERE promotion_id = #{promotionId}
    </delete>

    <!-- 根据活动ID查询关联的产品ID列表 -->
    <select id="selectProductIdsByPromotionId" resultType="java.lang.Long">
        SELECT product_id FROM promotion_product WHERE promotion_id = #{promotionId}
    </select>

    <!-- 根据产品ID查询关联的活动ID列表 -->
    <select id="selectPromotionIdsByProductId" resultType="java.lang.Long">
        SELECT promotion_id FROM promotion_product WHERE product_id = #{productId}
    </select>

</mapper>
